/* MARK: - 指南對話框 */
"guide.title" = "設定";
"guide.step1" = "1. 越獄您的 PS5 並傳送 pkg-receiver.elf — 它已內建在本應用中（見下方「顯示資源」）。";
"guide.step2" = "2. 等待主機提示「正在 12800 連接埠監聽」。";
"guide.step3" = "3. 將主機與本 Mac 接入同一網路（Wi-Fi 或區域網路）。主機無需連網。";
"guide.step4" = "4. 開啟 PKG Sender — 它會自動找到主機，並在位址變化時詢問是否切換。";
"guide.step5" = "5. 點擊「掃描磁碟機…」（或「+ 新增資料夾」，或直接把檔案/資料夾拖入視窗），選擇遊戲，點擊「傳送 PKG」。";
"guide.step6" = "6. 更新和 DLC 會與其基礎遊戲綁定（相同 title id，例如 PPSA12345 — 不同地區代碼會分開顯示）。點擊卡片上的 🔗 標記可僅顯示該系列。";
"guide.lanTitle" = "區域網路連線";
"guide.lanIntro" = "PKG Sender 透過兩種方式連接您的 PS5/PS4。";
"guide.method1Title" = "方式一 — 透過路由器";
"guide.method1" = "最簡單的方式 — 將本 Mac 和主機都連接到同一台路由器。無需手動設定 IP。";
"guide.method2Title" = "方式二 — 直連網路線";
"guide.method2" = "用一根網路線將 Mac 直連主機，不經過路由器。在沒有 DHCP 時，需要在兩端手動設定靜態位址：";
"guide.method2diagram" = "Mac ───── 乙太網路 ───── PS5/PS4\n192.168.10.1          192.168.10.2";
"guide.method2step1" = "1) Mac — 系統設定 → 網路 → 乙太網路 → 詳細資料 → TCP/IP：手動，192.168.10.1，子網路遮罩 255.255.255.0，閘道/DNS 留空。";
"guide.method2step2" = "2) 主機 — 網路設定 → 手動 IP：192.168.10.2，遮罩 255.255.255.0，閘道和 DNS 留空。";
"guide.method2step3" = "3) 在主機上啟動 PKG Receiver，然後在 Mac 上啟動 PKG Sender — 選擇本機位址，輸入主機 IP，點擊「測試」。";
"guide.directCableWarn" = "⚠ 切勿讓直連網路線保持自動 IP：Mac 或主機會回退到 169.254.x.x，而 PKG Sender 會刻意忽略該位址。如果插了網路線卻找不到主機，幾乎都是這個原因。";
"guide.ps4TipTitle" = "PS4 提速提示";
"guide.ps4Tip" = "在 PS4 上使用 Remote Package Installer（flatz，12800 連接埠）— 約 75 MB/s。GoldHEN 路徑上限約 50 MB/s，因為主機會逐個獲取分片；該上限在主機側，而非您的網路。PKG Sender 會自動優先嘗試 RPI。";
"guide.troubleTitle" = "疑難排解";
"guide.trouble.noReceiver" = "• 「無接收端」 — ELF 未在主機上執行。請重新傳送。";
"guide.trouble.noAdapter" = "• 「無網路介面卡」 — 本 Mac 沒有活動的區域網路/Wi-Fi。請檢查網路線或 Wi-Fi。";
"guide.trouble.pushNoStart" = "• 傳送成功但下載始終不開始 — 請在系統設定 → 網路 → 防火牆中允許 PKG Sender 的入站連線（本地伺服器監聽 TCP 9898）。";
"guide.trouble.ipChanges" = "• 主機 IP 經常變化（DHCP）— 只需重新開啟應用，它會提供新位址。";
"guide.close" = "關閉";

