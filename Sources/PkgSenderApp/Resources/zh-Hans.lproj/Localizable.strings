/* MARK: - 指南对话框 */
"guide.title" = "设置";
"guide.step1" = "1. 越狱您的 PS5 并发送 pkg-receiver.elf — 它已内置在本应用中（见下方“显示资源”）。";
"guide.step2" = "2. 等待主机提示“正在 12800 端口监听”。";
"guide.step3" = "3. 将主机与本 Mac 接入同一网络（Wi-Fi 或局域网）。主机无需联网。";
"guide.step4" = "4. 打开 PKG Sender — 它会自动找到主机，并在地址变化时询问是否切换。";
"guide.step5" = "5. 点击“扫描驱动器…”（或“+ 添加文件夹”，或直接把文件/文件夹拖入窗口），选择游戏，点击“发送 PKG”。";
"guide.step6" = "6. 更新和 DLC 会与其基础游戏绑定（相同 title id，例如 PPSA12345 — 不同地区代码会分开显示）。点击卡片上的 🔗 标记可仅显示该系列。";
"guide.lanTitle" = "局域网连接";
"guide.lanIntro" = "PKG Sender 通过两种方式连接您的 PS5/PS4。";
"guide.method1Title" = "方式一 — 通过路由器";
"guide.method1" = "最简单的方式 — 将本 Mac 和主机都连接到同一台路由器。无需手动设置 IP。";
"guide.method2Title" = "方式二 — 直连网线";
"guide.method2" = "用一根网线将 Mac 直连主机，不经过路由器。在没有 DHCP 时，需要在两端手动设置静态地址：";
"guide.method2diagram" = "Mac ───── 以太网 ───── PS5/PS4\n192.168.10.1          192.168.10.2";
"guide.method2step1" = "1) Mac — 系统设置 → 网络 → 以太网 → 详细信息 → TCP/IP：手动，192.168.10.1，子网掩码 255.255.255.0，网关/DNS 留空。";
"guide.method2step2" = "2) 主机 — 网络设置 → 手动 IP：192.168.10.2，掩码 255.255.255.0，网关和 DNS 留空。";
"guide.method2step3" = "3) 在主机上启动 PKG Receiver，然后在 Mac 上启动 PKG Sender — 选择本机地址，输入主机 IP，点击“测试”。";
"guide.directCableWarn" = "⚠ 切勿让直连网线保持自动 IP：Mac 或主机会回退到 169.254.x.x，而 PKG Sender 会刻意忽略该地址。如果插了网线却找不到主机，几乎都是这个原因。";
"guide.ps4TipTitle" = "PS4 提速提示";
"guide.ps4Tip" = "在 PS4 上使用 Remote Package Installer（flatz，12800 端口）— 约 75 MB/s。GoldHEN 路径上限约 50 MB/s，因为主机会逐个获取分片；该上限在主机侧，而非您的网络。PKG Sender 会自动优先尝试 RPI。";
"guide.troubleTitle" = "故障排除";
"guide.trouble.noReceiver" = "• “无接收端” — ELF 未在主机上运行。请重新发送。";
"guide.trouble.noAdapter" = "• “无网络适配器” — 本 Mac 没有活动的局域网/Wi-Fi。请检查网线或 Wi-Fi。";
"guide.trouble.pushNoStart" = "• 发送成功但下载始终不开始 — 请在系统设置 → 网络 → 防火墙中允许 PKG Sender 的入站连接（本地服务器监听 TCP 9898）。";
"guide.trouble.ipChanges" = "• 主机 IP 经常变化（DHCP）— 只需重新打开应用，它会提供新地址。";
"guide.close" = "关闭";

