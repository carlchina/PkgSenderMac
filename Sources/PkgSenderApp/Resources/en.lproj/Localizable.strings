/* MARK: - Guide dialog */
"guide.title" = "Setup";
"guide.step1" = "1. Jailbreak your PS5 and send pkg-receiver.elf — it ships inside this app (Show resources below).";
"guide.step2" = "2. Wait for the console toast “listening on port 12800”.";
"guide.step3" = "3. Put the console on the same network as this Mac (Wi-Fi or LAN). No internet needed on the console.";
"guide.step4" = "4. Open PKG Sender — it finds the console by itself and asks to switch if its address changed.";
"guide.step5" = "5. Press Scan drives… (or + Add folder, or just drop files/folders onto the window), select games, press Send PKG.";
"guide.step6" = "6. Updates and DLCs stay glued to their base game (same title id, e.g. PPSA12345 — different region codes stay separate). Click the 🔗 chip on a card to show only that family.";
"guide.lanTitle" = "LAN connection";
"guide.lanIntro" = "PKG Sender connects to your PS5/PS4 in two ways.";
"guide.method1Title" = "Method 1 — Through a router";
"guide.method1" = "The easiest option — connect both your Mac and console to the same router. No manual IP setup needed.";
"guide.method2Title" = "Method 2 — Direct cable";
"guide.method2" = "Mac straight to console with an Ethernet cable, no router. With no DHCP around, set static addresses on both ends:";
"guide.method2diagram" = "Mac ───── Ethernet ───── PS5/PS4\n192.168.10.1          192.168.10.2";
"guide.method2step1" = "1) Mac — System Settings → Network → Ethernet → Details → TCP/IP: Manual, 192.168.10.1, subnet mask 255.255.255.0, empty gateway/DNS.";
"guide.method2step2" = "2) Console — Network settings → manual IP: 192.168.10.2, mask 255.255.255.0, gateway and DNS empty.";
"guide.method2step3" = "3) Start the PKG Receiver on the console, then PKG Sender on the Mac — pick the PC address, type the console IP, press Test.";
"guide.directCableWarn" = "⚠ Do NOT leave a direct cable on automatic IP: the Mac or the console may fall back to 169.254.x.x, which PKG Sender ignores on purpose. If the cable is in but nothing is found, this is almost always the cause.";
"guide.ps4TipTitle" = "PS4 speed tip";
"guide.ps4Tip" = "On PS4 use Remote Package Installer (flatz, port 12800) — about 75 MB/s. The GoldHEN path tops out near 50 MB/s because the console fetches pieces one-by-one; that cap is on the console side, not your network. PKG Sender tries RPI first automatically.";
"guide.troubleTitle" = "Troubleshooting";
"guide.trouble.noReceiver" = "• “No receiver” — the ELF is not running on the console. Send it again.";
"guide.trouble.noAdapter" = "• “No network adapter” — this Mac has no active LAN/Wi-Fi. Check cable or Wi-Fi.";
"guide.trouble.pushNoStart" = "• Push goes through but the download never starts — allow incoming connections for PKG Sender in System Settings → Network → Firewall (the local server listens on TCP 9898).";
"guide.trouble.ipChanges" = "• Console IP changes often (DHCP) — just reopen the app; it will offer the new address.";
"guide.close" = "Close";

